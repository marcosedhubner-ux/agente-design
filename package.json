{
  "name": "atelie-azul",
  "productName": "Ateliê Azul",
  "version": "1.0.0",
  "description": "A desktop AI design mentor built with Electron, powered by the Claude Code CLI instead of a paid API key",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package:win": "electron-packager . \"Atelie Azul\" --platform=win32 --arch=x64 --icon=assets/icon.ico --out=dist --overwrite"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-packager": "^17.1.2"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "onnxruntime-node@1.17.3": true,
    "sharp@0.32.6": true,
    "sharp@0.35.3": true
  },
  "dependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "dotenv": "^16.6.1",
    "sharp": "^0.35.3"
  }
}
