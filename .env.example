# Command or full path used to spawn the Claude Code CLI.
# Leave it as "claude" if the CLI is already on your PATH (the default after
# `npm install -g @anthropic-ai/claude-code` and `claude login`).
# Only set this if you need to point at a specific binary, e.g. on Windows:
# CLAUDE_CLI_COMMAND=C:\Users\you\AppData\Roaming\npm\claude.cmd
CLAUDE_CLI_COMMAND=claude
