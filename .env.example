# Command or full path used to spawn the Claude Code CLI.
# Leave it as "claude" if the CLI is already on your PATH (the default after
# `npm install -g @anthropic-ai/claude-code` and `claude login`).
# Only set this if you need to point at a specific binary, e.g. on Windows:
# CLAUDE_CLI_COMMAND=C:\Users\you\AppData\Roaming\npm\claude.cmd
CLAUDE_CLI_COMMAND=claude

# Optional: Google AI Studio API key for higher-quality ("Nano Banana") image
# generation. Get a free key (no credit card needed) at
# https://aistudio.google.com/apikey
# If left empty, the app falls back to a free, lower-quality generator
# (Pollinations.ai) that needs no key at all.
GEMINI_API_KEY=

# Which Gemini image model to call. The default is the original free
# "Nano Banana" and it RETIRES 2026-10-02. After that date, either point
# this at whatever paid successor Google offers then (e.g. a "Nano Banana 2"
# model id — check https://ai.google.dev/gemini-api/docs/pricing), or just
# delete GEMINI_API_KEY above to keep using the always-free fallback.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
